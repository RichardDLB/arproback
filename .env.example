# Copy to .env for local development and replace each placeholder.
DB_URL=jdbc:mysql://localhost:3306/portfolio?useSSL=false&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=replace_me
DB_POOL_SIZE=2

# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_base64_encoded_512_bit_secret
JWT_EXPIRATION=3600

# Optional: creates the first administrator on startup if the username is new.
APP_ADMIN_NAME=Portfolio Administrator
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace_with_at_least_12_characters